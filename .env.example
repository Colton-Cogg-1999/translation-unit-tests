# Copy to .env and fill in. .env is git-ignored.
# Not needed to reproduce the reported results: see "Reproducing" in the README (L10N_OFFLINE=1).
# Get a key at https://openrouter.ai/keys. Leave blank to use a local OpenAI-compatible server
# (e.g. llama.cpp on http://127.0.0.1:8081/v1).
OPENROUTER_API_KEY=

# Model roles: any id from https://openrouter.ai/models. Defaults are the models the study used.
# JUDGE: judges assertions and runs segment QE (also generates the suite unless L10N_GEN_MODEL is set)
L10N_JUDGE_MODEL=anthropic/claude-sonnet-5.5
# L10N_GEN_MODEL=anthropic/claude-sonnet-5.5
# L10N_GOLD_MODEL=openai/gpt-5.4
# L10N_ADJUDICATE_MODEL=openai/gpt-5.4
# L10N_MTUNIT_ENGINES=meta-llama/llama-4-scout,openai/gpt-5.4-nano,openai/gpt-5.4-mini
# MT: the translation model used in the pilot study
L10N_MT_MODEL=openai/gpt-5.4-mini
# Reasoning effort for models that "think" (none|minimal|low|medium|high)
L10N_REASONING_EFFORT=low
